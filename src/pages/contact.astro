---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { BOOKING_URL } from '../consts';
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead
            title="Contact | My Myo"
            description="Find and book James Maddock, Clinical Myotherapist, at The Urban Alchemist, Carlton North, Melbourne."
        />
    </head>
    <body>
        <Header />
        <main>
            <h1>Contact</h1>
            <p class="lede">I practise at The Urban Alchemist, on Nicholson Street in Carlton North.</p>

            <h2>Bookings</h2>
            <p>
                Appointments are booked online through the clinic's booking system. Choose
                "Myotherapy" when booking if it's a new myotherapy matter; initial manual
                lymphatic drainage appointments are 90 minutes.
            </p>
            <p>
                <a class="cta-button" href={BOOKING_URL} target="_blank">Book online</a>
            </p>

            <h2>Other ways to reach me</h2>
            <ul>
                <li>Email: <a href="mailto:hello@massage.melbourne">hello@massage.melbourne</a></li>
                <li>Practice: The Urban Alchemist, Carlton North, Victoria</li>
            </ul>

            <h2>Not sure if I'm the right fit?</h2>
            <p>
                If you're unsure whether myotherapy is right for what's going on, send me an
                email describing your situation and I'll point you in the right direction —
                including onward referral if another practitioner would serve you better.
            </p>
        </main>
        <Footer />
    </body>
</html>
