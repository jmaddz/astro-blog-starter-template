---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE, BOOKING_URL } from '../consts';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<HeaderLink href="/services">Services</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/contact">Contact</HeaderLink>
		</div>
		<div class="header-actions">
			<a class="book-link" href={BOOKING_URL} target="_blank">Book now</a>
			<button class="theme-toggle" type="button" aria-label="Toggle dark mode">
				<span class="sr-only">Toggle dark mode</span>
				<svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
				<svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
			</button>
		</div>
	</nav>
</header>
<script>
	const btn = document.querySelector('.theme-toggle');
	btn?.addEventListener('click', () => {
		const dark = document.documentElement.classList.toggle('dark');
		localStorage.setItem('theme', dark ? 'dark' : 'light');
		const u = new URL(location.href);
		u.searchParams.set('theme', dark ? 'dark' : 'light');
		history.replaceState({}, '', u);
	});
</script>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: var(--surface);
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: rgb(var(--black));
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.header-actions {
		display: flex;
		align-items: center;
		gap: 0.5em;
	}
	.book-link {
		font-weight: 700;
		color: var(--accent);
		text-decoration: none;
	}
	.book-link:hover {
		color: var(--accent-dark);
	}
	.theme-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.5em;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 6px;
		background: transparent;
		color: rgb(var(--gray));
		cursor: pointer;
	}
	.theme-toggle:hover {
		color: var(--accent);
		border-color: var(--accent);
	}
	:root .icon-moon {
		display: inline;
	}
	:root .icon-sun {
		display: none;
	}
	:root.dark .icon-moon {
		display: none;
	}
	:root.dark .icon-sun {
		display: inline;
	}
	@media (max-width: 720px) {
		.book-link {
			display: none;
		}
	}
</style>
