---
const today = new Date();
---

<footer>
	<div>
		&copy; {today.getFullYear()} James Maddock · My Myo · Clinical Myotherapy, Carlton North (Naarm / Melbourne)
	</div>
	<div class="footer-links">
		<a href="https://massage.melbourne" target="_blank">massage.melbourne</a>
		<a href="/rss.xml">RSS</a>
	</div>
</footer>
<style>
	footer {
		padding: 2em 1em 4em 1em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: center;
	}
	.footer-links {
		display: flex;
		justify-content: center;
		gap: 1.5em;
		margin-top: 0.75em;
	}
	.footer-links a {
		text-decoration: none;
		color: rgb(var(--gray));
	}
	.footer-links a:hover {
		color: var(--accent);
	}
</style>
